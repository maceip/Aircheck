<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android 17+ strict default: forbid global cleartext HTTP and enforce system CA trust. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Scoped cleartext allowance strictly for USB ADB loopback, emulator host bridge,
         and the paired LAN Mac Studio rig (:8443) paired with ACCESS_LOCAL_NETWORK. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.0.242</domain>
    </domain-config>
</network-security-config>
