rules_version = '2';

// ===============================================================
// Assumed Data Model (Aircheck v2 Blue-Ocean Cloud-First)
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: /users/{userId}/scripts/{scriptId}
// Document ID: ^[a-zA-Z0-9_-]{1,128}$
// Access: Owner-only CRUD (get, list, create, update, delete)
// Fields:
//   - userId: string (required, immutable, == userId, <= 128 chars) - Owner Firebase Auth UID
//   - title: string (required, <= 180 chars) - Headline or working title of the broadcast segment
//   - ideaSpark: string (required, <= 1000 chars) - Raw initial spark or thesis
//   - sourceUrl: string (optional, <= 500 chars, empty or http(s):// URL) - Optional Stage 0 source URL
//   - targetDurationSec: int (required, in [15, 30, 45, 60]) - Target runtime in seconds
//   - beats: list (required, <= 40 validated beat maps) - Ordered script beat objects
//   - stageConfig: map (required, strict allowed keys and size bounds) - Stage backdrop, photo SHA, Stage4Mode, chyrons
//   - voiceSource: string (required, in ['ENROLLED_VOICE_CLONE', 'MIC_VOICEOVER']) - Selected voice source mode
//   - voiceSelectionId: string | null (optional, <= 128 chars) - Optional enrolled voice ID override
//   - createdAt: timestamp (required, immutable, <= request.time) - Creation timestamp
//   - updatedAt: timestamp (required, <= request.time, >= createdAt) - Last update timestamp
//
// Collection: /users/{userId}/presets/{presetId}
// Document ID: ^[a-zA-Z0-9_-]{1,128}$
// Access: Owner-only CRUD (get, list, create, update, delete)
// Fields:
//   - userId: string (required, immutable, == userId, <= 128 chars) - Owner Firebase Auth UID
//   - name: string (required, 1..80 chars) - Preset display name
//   - backdropPresetId: string (required, 1..64 chars) - Selected backdrop preset identifier
//   - targetDurationSec: int (required, in [15, 30, 45, 60]) - Default target runtime in seconds
//   - voiceSource: string (required, in ['ENROLLED_VOICE_CLONE', 'MIC_VOICEOVER']) - Default voice source mode
//   - createdAt: timestamp (required, immutable, <= request.time) - Creation timestamp
//   - updatedAt: timestamp (required, <= request.time, >= createdAt) - Last update timestamp
//
// Collection: /users/{userId}/jobs/{jobId}
// Document ID: ^[a-zA-Z0-9_-]{1,128}$
// Access: Owner get & list ONLY; all client writes explicitly DENIED
//         (Cloud Functions v2 Admin SDK exclusively writes pipeline job status,
//         SHA-256 artifacts, waveformPeaks, alignedWords, and final URLs)
//
// Collection: /users/{userId}/profile/{docId}
// Document ID: 'persona' ONLY for owner get
// Access: Owner get ONLY when docId == 'persona'; list and all client writes explicitly DENIED
//         (Phase A GPU Training / Cloud Functions v2 Admin SDK exclusively writes
//         enrolled headModelId, voiceId, trainingStatus, and fcmToken)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Default-Deny Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function uidUnchanged(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid;
    }

    function uidNotModified(data, prev) {
      return data.userId == prev.userId;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string &&
             (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isValidVoiceSource(val) {
      return val is string && val in ['ENROLLED_VOICE_CLONE', 'MIC_VOICEOVER'];
    }

    function isValidTargetDuration(val) {
      return val is int && val in [15, 30, 45, 60];
    }

    function isValidStage4Mode(val) {
      return val is string &&
             val in ['photo_head_lora', 'saved_loop_latentsync', 'libreclip_crop'];
    }

    function isValidBeat(beat) {
      return beat is map &&
             beat.keys().hasOnly([
               'id', 'index', 'spokenText', 'durationSec', 'cut',
               'mentionTag', 'depthTextTag', 'anchorWord', 'evidenceSource',
               'sfxTag', 'phoneticOverride', 'bRollPrompt'
             ]) &&
             beat.id is string && beat.id.size() >= 1 && beat.id.size() <= 64 &&
             beat.index is int && beat.index >= 0 && beat.index < 40 &&
             beat.spokenText is string && beat.spokenText.size() <= 600 &&
             beat.durationSec is int && beat.durationSec >= 1 && beat.durationSec <= 300 &&
             beat.cut is bool &&
             (!('mentionTag' in beat) || (beat.mentionTag is string && beat.mentionTag.size() <= 64)) &&
             (!('depthTextTag' in beat) || (beat.depthTextTag is string && beat.depthTextTag.size() <= 64)) &&
             (!('anchorWord' in beat) || (beat.anchorWord is string && beat.anchorWord.size() <= 48)) &&
             (!('evidenceSource' in beat) || (beat.evidenceSource is string && beat.evidenceSource.size() <= 120)) &&
             (!('sfxTag' in beat) || (beat.sfxTag is string && beat.sfxTag.size() <= 64)) &&
             (!('phoneticOverride' in beat) || (beat.phoneticOverride is string && beat.phoneticOverride.size() <= 64)) &&
             (!('bRollPrompt' in beat) || (beat.bRollPrompt is string && beat.bRollPrompt.size() <= 240));
    }

    function isValidStageConfig(cfg) {
      return cfg is map &&
             cfg.keys().hasOnly([
               'backdropPresetId', 'customBackdropPrompt', 'photoSha',
               'normalizedPhotoSha', 'stage4Mode', 'chyronHeadline',
               'chyronSubline', 'cornerBugText', 'showBrandBug'
             ]) &&
             (!('backdropPresetId' in cfg) || (cfg.backdropPresetId is string && cfg.backdropPresetId.size() <= 64)) &&
             (!('customBackdropPrompt' in cfg) || (cfg.customBackdropPrompt is string && cfg.customBackdropPrompt.size() <= 240)) &&
             (!('photoSha' in cfg) || cfg.photoSha == null || (cfg.photoSha is string && cfg.photoSha.size() <= 64)) &&
             (!('normalizedPhotoSha' in cfg) || cfg.normalizedPhotoSha == null || (cfg.normalizedPhotoSha is string && cfg.normalizedPhotoSha.size() <= 64)) &&
             (!('stage4Mode' in cfg) || isValidStage4Mode(cfg.stage4Mode)) &&
             (!('chyronHeadline' in cfg) || (cfg.chyronHeadline is string && cfg.chyronHeadline.size() <= 80)) &&
             (!('chyronSubline' in cfg) || (cfg.chyronSubline is string && cfg.chyronSubline.size() <= 100)) &&
             (!('cornerBugText' in cfg) || (cfg.cornerBugText is string && cfg.cornerBugText.size() <= 32)) &&
             (!('showBrandBug' in cfg) || cfg.showBrandBug is bool);
    }

    // ===============================================================
    // Domain Validators (Called in BOTH create and update)
    // ===============================================================

    function isValidScriptProject(data, userId) {
      return uidUnchanged(data, userId) &&
             data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 180 &&
             data.ideaSpark is string && data.ideaSpark.size() <= 1000 &&
             (!('sourceUrl' in data) ||
              (data.sourceUrl is string &&
               data.sourceUrl.size() <= 500 &&
               (data.sourceUrl.size() == 0 || isValidUrl(data.sourceUrl)))) &&
             isValidTargetDuration(data.targetDurationSec) &&
             data.beats is list && data.beats.size() <= 40 &&
             (data.beats.size() == 0 || isValidBeat(data.beats[0])) &&
             isValidStageConfig(data.stageConfig) &&
             isValidVoiceSource(data.voiceSource) &&
             (!('voiceSelectionId' in data) ||
              data.voiceSelectionId == null ||
              (data.voiceSelectionId is string && data.voiceSelectionId.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.updatedAt >= data.createdAt;
    }

    function isValidStudioPreset(data, userId) {
      return uidUnchanged(data, userId) &&
             data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.backdropPresetId is string && data.backdropPresetId.size() >= 1 && data.backdropPresetId.size() <= 64 &&
             isValidTargetDuration(data.targetDurationSec) &&
             isValidVoiceSource(data.voiceSource) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.updatedAt >= data.createdAt;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId}/scripts/{scriptId} {
      allow get: if isOwner(userId) && isValidId(scriptId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(scriptId) &&
                       hasRequiredFields(request.resource.data, [
                         'userId', 'title', 'ideaSpark', 'targetDurationSec',
                         'beats', 'stageConfig', 'voiceSource', 'createdAt', 'updatedAt'
                       ]) &&
                       hasOnlyAllowedFields(request.resource.data, [
                         'userId', 'title', 'ideaSpark', 'sourceUrl', 'targetDurationSec',
                         'beats', 'stageConfig', 'voiceSource', 'voiceSelectionId',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidScriptProject(request.resource.data, userId);

      allow update: if isOwner(userId) &&
                       isValidId(scriptId) &&
                       hasOnlyAllowedFields(request.resource.data, [
                         'userId', 'title', 'ideaSpark', 'sourceUrl', 'targetDurationSec',
                         'beats', 'stageConfig', 'voiceSource', 'voiceSelectionId',
                         'createdAt', 'updatedAt'
                       ]) &&
                       uidNotModified(request.resource.data, resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'title', 'ideaSpark', 'sourceUrl', 'targetDurationSec',
                         'beats', 'stageConfig', 'voiceSource', 'voiceSelectionId', 'updatedAt'
                       ]) &&
                       isValidScriptProject(request.resource.data, userId);

      allow delete: if isOwner(userId) && isValidId(scriptId);
    }

    match /users/{userId}/presets/{presetId} {
      allow get: if isOwner(userId) && isValidId(presetId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(presetId) &&
                       hasRequiredFields(request.resource.data, [
                         'userId', 'name', 'backdropPresetId', 'targetDurationSec',
                         'voiceSource', 'createdAt', 'updatedAt'
                       ]) &&
                       hasOnlyAllowedFields(request.resource.data, [
                         'userId', 'name', 'backdropPresetId', 'targetDurationSec',
                         'voiceSource', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidStudioPreset(request.resource.data, userId);

      allow update: if isOwner(userId) &&
                       isValidId(presetId) &&
                       hasOnlyAllowedFields(request.resource.data, [
                         'userId', 'name', 'backdropPresetId', 'targetDurationSec',
                         'voiceSource', 'createdAt', 'updatedAt'
                       ]) &&
                       uidNotModified(request.resource.data, resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'backdropPresetId', 'targetDurationSec', 'voiceSource', 'updatedAt'
                       ]) &&
                       isValidStudioPreset(request.resource.data, userId);

      allow delete: if isOwner(userId) && isValidId(presetId);
    }

    match /users/{userId}/jobs/{jobId} {
      allow get: if isOwner(userId) && isValidId(jobId);
      allow list: if isOwner(userId);
      // Cloud Functions v2 Admin SDK exclusively writes pipeline job status,
      // SHA-256 artifacts, waveformPeaks, alignedWords, and signed/final URLs.
      allow create, update, delete: if false;
    }

    match /users/{userId}/profile/{docId} {
      allow get: if isOwner(userId) && docId == 'persona';
      // Phase A GPU Training / Cloud Functions v2 Admin SDK exclusively writes
      // enrolled headModelId, voiceId, trainingStatus, and fcmToken.
      allow list, create, update, delete: if false;
    }
  }
}
