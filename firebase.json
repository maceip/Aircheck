{
  "firestore": [
    {
      "database": "ai-studio-android-aircheck-bd33bd23-ac09-4e5c-87a7-6d84c21f8ad9",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "backend/functions",
      "codebase": "aircheck-functions",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "test/**"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
