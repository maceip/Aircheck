{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircheck.local/schemas/ota_bundle_manifest.schema.json",
  "title": "OtaBundleManifest",
  "description": "Tailscale/HTTP OTA bundle manifest for s2-pro-GGUF + nightly 35MB Rank-32 GGUF LoRA delta + LiteRT 44.1kHz DAC codec decoder + sherpa-onnx/WeSpeaker/DNSMOS p808 verifiers + room IR/tone + lexicon.json. Stored under noBackupFilesDir (NEVER in APK).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "lora_version",
    "created_at_utc",
    "sample_rate_hz",
    "foreground_ram_ceiling_mb",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "bundle_version": { "type": "string", "minLength": 1 },
    "lora_version": { "type": "integer", "minimum": 0 },
    "created_at_utc": { "type": "string", "minLength": 1 },
    "sample_rate_hz": { "type": "integer", "const": 44100 },
    "foreground_ram_ceiling_mb": { "type": "integer", "minimum": 512, "maximum": 9500 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "filename",
          "format",
          "sha256",
          "size_bytes",
          "estimated_ram_mb",
          "update_cadence"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "s2_pro_base_gguf",
              "voice_lora_gguf",
              "codec_decoder_tflite",
              "sherpa_ctc_aligner",
              "wespeaker_resnet34_onnx",
              "master_centroid_bin",
              "dnsmos_p808_onnx",
              "room_ir_pcm",
              "room_tone_pcm",
              "g2p_lexicon"
            ]
          },
          "filename": { "type": "string", "minLength": 1 },
          "format": {
            "type": "string",
            "enum": ["gguf", "tflite", "onnx", "bin", "pcm", "json", "tar_gz"]
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "estimated_ram_mb": { "type": "integer", "minimum": 1 },
          "update_cadence": {
            "type": "string",
            "enum": ["static_once", "nightly_delta"]
          },
          "download_path": { "type": ["string", "null"] }
        }
      }
    }
  }
}
