{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircheck.local/schemas/ota_bundle_manifest.schema.json",
  "title": "OtaBundleManifest",
  "description": "Tailscale/WireGuard OTA model bundle manifest exported by litert-torch / ai-edge-quantizer and RVC v2 export scripts. Model files live under Android noBackupFilesDir/bundles/{bundle_version}/ and are NEVER packed into the APK.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "created_at_utc",
    "prosody_backend",
    "sample_rate_hz",
    "foreground_ram_ceiling_mb",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1
    },
    "prosody_backend": {
      "type": "string",
      "enum": [
        "ming_3_0_tts_tiny",
        "fish_s2_pro_4b",
        "voxcpm2"
      ]
    },
    "adapter_checkpoint_id": {
      "type": ["string", "null"]
    },
    "sample_rate_hz": {
      "type": "integer",
      "const": 48000
    },
    "foreground_ram_ceiling_mb": {
      "type": "integer",
      "minimum": 512,
      "maximum": 9500
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "filename",
          "format",
          "sha256",
          "size_bytes",
          "estimated_ram_mb",
          "stage"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "prosody_generator",
              "ctc_verifier",
              "wespeaker_verifier",
              "speaker_centroid",
              "utmos_verifier",
              "rvc_v2_resynth",
              "room_ir",
              "g2p_lexicon"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "litertlm",
              "tflite",
              "onnx",
              "json",
              "f32",
              "wav"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "estimated_ram_mb": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "g2p",
              "stage_a",
              "stage_b",
              "stage_c"
            ]
          },
          "download_path": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
