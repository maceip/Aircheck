{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircheck.local/schemas/clause_node.schema.json",
  "title": "VoiceProjectManifestAndClauseNode",
  "description": "Canonical 44.1 kHz Float32 PCM (64-byte aligned, headerless mmap) schema shared across :core-engine, :core-verifier, :audio-edl, :ui-clipper, and :sync-trainer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "sampleRate",
    "globalGapScale",
    "activeLoraVersion",
    "clauses"
  ],
  "properties": {
    "projectId": { "type": "string", "minLength": 1 },
    "sampleRate": { "type": "integer", "const": 44100 },
    "globalGapScale": { "type": "number", "minimum": 0.25, "maximum": 1.0 },
    "activeLoraVersion": { "type": "integer", "minimum": 0 },
    "clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/ClauseNode" }
    }
  },
  "$defs": {
    "ClauseNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clauseId",
        "index",
        "rawText",
        "normalizedPhonemes",
        "selectedTakeIndex",
        "baseGapAfterSamples",
        "candidates"
      ],
      "properties": {
        "clauseId": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "rawText": { "type": "string", "minLength": 1 },
        "normalizedPhonemes": { "type": "string" },
        "acousticPrefixPcmPath": {
          "type": ["string", "null"],
          "description": "Trailing 1.5s (66,150 samples @ 44.1kHz f32) of previous winning clause."
        },
        "selectedTakeIndex": { "type": "integer", "minimum": 0 },
        "baseGapAfterSamples": {
          "type": "integer",
          "minimum": 0,
          "default": 3969,
          "description": "Default 3969 samples (90ms @ 44.1kHz)."
        },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/CandidateTake" }
        }
      }
    },
    "CandidateTake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "takeId",
        "pcmFilePath",
        "totalSamples",
        "discreteAudioTokens",
        "seed",
        "temperature",
        "metrics",
        "tokens"
      ],
      "properties": {
        "takeId": { "type": "string", "minLength": 1 },
        "pcmFilePath": { "type": "string", "minLength": 1 },
        "totalSamples": { "type": "integer", "minimum": 0 },
        "discreteAudioTokens": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Flattened discrete s2-pro audio codebook token IDs logged for Tinker OPSD/GRPO."
        },
        "seed": { "type": "integer" },
        "temperature": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "metrics": { "$ref": "#/$defs/GateMetrics" },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/WordToken" }
        }
      }
    },
    "GateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cer",
        "maxPhonemeDurationMs",
        "speakerCosineSim",
        "dnsmosP808",
        "tailRmsDb",
        "syllablesPerSec",
        "passedAllGates"
      ],
      "properties": {
        "cer": { "type": "number", "minimum": 0.0, "description": "Gate 1: Must be == 0.0f" },
        "maxPhonemeDurationMs": { "type": "number", "minimum": 0.0, "description": "Gate 1b: Must be <= 380.0f" },
        "speakerCosineSim": { "type": "number", "minimum": -1.0, "maximum": 1.0, "description": "Gate 2: WeSpeaker ResNet34 >= 0.86f" },
        "dnsmosP808": { "type": "number", "minimum": 0.0, "maximum": 5.0, "description": "Gate 3: DNSMOS p808 >= 4.10f" },
        "tailRmsDb": { "type": "number", "description": "Gate 3b: Final 80ms RMS energy <= -45.0f dBFS" },
        "syllablesPerSec": { "type": "number", "minimum": 0.0, "description": "Gate 4: Target band 4.2f..6.1f" },
        "passedAllGates": { "type": "boolean" }
      }
    },
    "WordToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word",
        "startSample",
        "endSample",
        "zeroCrossIn",
        "zeroCrossOut",
        "f0PeakSample"
      ],
      "properties": {
        "word": { "type": "string", "minLength": 1 },
        "startSample": { "type": "integer", "minimum": 0 },
        "endSample": { "type": "integer", "minimum": 0 },
        "zeroCrossIn": { "type": "integer", "minimum": 0, "description": "Nearest zero-crossing within +/- 88 samples (2ms @ 44.1kHz)" },
        "zeroCrossOut": { "type": "integer", "minimum": 0, "description": "Nearest zero-crossing within +/- 88 samples (2ms @ 44.1kHz)" },
        "f0PeakSample": { "type": "integer", "minimum": 0 },
        "videoAnchorId": { "type": ["string", "null"] }
      }
    }
  }
}
