{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aircheck.local/schemas/preference_tuple.schema.json",
  "title": "PreferenceTelemetryRecord",
  "description": "Exact preferences.jsonl schema uploaded over Tailscale/Wi-Fi from Android to sync-trainer/home-daemon/tinker_voice_daemon.py for discrete-token OPSD + GRPO LoRA updates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "clause_id",
    "lora_version",
    "raw_text",
    "normalized_phonemes",
    "user_action",
    "user_gap_scale",
    "chosen_tokens",
    "rejected_tokens",
    "gate_failures"
  ],
  "properties": {
    "timestamp": { "type": "integer", "minimum": 0 },
    "clause_id": { "type": "string", "minLength": 1 },
    "lora_version": { "type": "integer", "minimum": 0 },
    "raw_text": { "type": "string", "minLength": 1 },
    "normalized_phonemes": { "type": "string" },
    "user_action": {
      "type": "string",
      "enum": [
        "TAKE_SWAP",
        "PACE_EDIT",
        "TAKE_SWAP_AND_PACE_EDIT",
        "PHONEME_OVERRIDE",
        "VIDEO_ANCHOR_SNAP",
        "PROJECT_EXPORT"
      ]
    },
    "user_gap_scale": { "type": "number", "minimum": 0.25, "maximum": 1.0 },
    "chosen_tokens": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "rejected_tokens": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "gate_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seed", "cer", "reason", "tokens"],
        "properties": {
          "seed": { "type": "integer" },
          "cer": { "type": "number", "minimum": 0.0 },
          "reason": { "type": "string", "minLength": 1 },
          "tokens": {
            "type": "array",
            "items": { "type": "integer" }
          }
        }
      }
    }
  }
}
